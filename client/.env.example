# Client (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HMK Mobile
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used for Open Graph / canonical URLs on blog article pages
# In production set this to your public domain e.g. https://hmkmobile.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay — public key only (secret stays server-side)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google OAuth (Sign In with Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

